# VAPID Web Push Keys (Opzionale: se non specificate, il sistema le genera automaticamente in /data/vapid.json)
# Generabili anche con il comando: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@preventivi3d.local

# Facoltativi: download automatico dei file da Thingiverse e MyMiniFactory nel portale richieste
# THINGIVERSE_TOKEN=
# MYMINIFACTORY_API_KEY=
